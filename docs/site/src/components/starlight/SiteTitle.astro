---
// The wordmark, shared with the landing pages (same view-transition name), and a mono "docs" tag.
const { siteTitleHref } = Astro.locals.starlightRoute;
const docs = Astro.locals.starlightRoute.lang === 'zh-CN' ? '文档' : 'Docs';
---

<a href={siteTitleHref} class="cvsm-wordmark site-title">
	<span class="cvsm-wordmark__name">CVSM</span>
	<span class="cvsm-wordmark__tag" aria-hidden="true">{docs}</span>
</a>
